system automatic_transmission


/**
    1. Any piecewise continuous signal subject to the constraints
          0 <= throttle and throttle <= 100
          0 <= brake and brake <= 325
       
    2. Piecewise constant signals subject to the constraints
          discontinuity only possible every 5 seconds 
          0 <= throttle and throttle <= 100
          0 <= brake and brake <= 325
*/

#[disable(unused)]
signal throttle : Float

// what are the units? pressure?
#[disable(unused)]
signal brake : Float

signal rpm : Float

signal speed : Float

signal gear: Int


/**

    Taken from https://gitlab.com/goranf/ARCH-COMP/-/blob/master/models/FALS/transmission/requirements.txt
    Bardh Hoxha, Houssam Abbas, Georgios Fainekos
    Benchmarks for Temporal Logic Requirements for Automotive Systems
    ARCH 2014


    □ = always
    ◇ = eventually

    AT1:  □_[0.0, 20.0] (speed < 120.0)
    AT2:  □_[0.0, 10.0] (RPM < 4750.0)
    AT51: □_[0.0, 30.0] ((!(gear == 1.0) && ◇_[0.001, 0.1] (gear == 1.0)) ==> ◇_[0.001, 0.1] □_[0.0, 2.5] (gear == 1.0))
    AT52: □_[0.0, 30.0] ((!(gear == 2.0) && ◇_[0.001, 0.1] (gear == 2.0)) ==> ◇_[0.001, 0.1] □_[0.0, 2.5] (gear == 2.0))
    AT53: □_[0.0, 30.0] ((!(gear == 3.0) && ◇_[0.001, 0.1] (gear == 3.0)) ==> ◇_[0.001, 0.1] □_[0.0, 2.5] (gear == 3.0))
    AT54: □_[0.0, 30.0] ((!(gear == 4.0) && ◇_[0.001, 0.1] (gear == 4.0)) ==> ◇_[0.001, 0.1] □_[0.0, 2.5] (gear == 4.0))
    AT6a: (□_[0.0, 30.0] (RPM < 3000.0) ==> □_[0.0, 4.0] (speed < 35.0))
    AT6b: (□_[0.0, 30.0] (RPM < 3000.0) ==> □_[0.0, 8.0] (speed < 50.0))
    AT6c: (□_[0.0, 30.0] (RPM < 3000.0) ==> □_[0.0, 20.0] (speed < 65.0))

    AT6abc: AT6a && AT6b && AT6c

*/

/// AT1:  □_[0.0, 20.0] (speed < 120.0)
spec speedLim = always [0.0, 20.0] (speed < 120.0)

/// AT2:  □_[0.0, 10.0] (RPM < 4750.0)
spec rpmLim = always [0.0, 10.0] (rpm < 4750.0)

/// For the first 30 seconds, 
///  if there is a transition to a gear, 
///    the gear remains steady for at least 2.5 seconds
/// AT5g for gear g from 1 to 4
def gearSteadyFor(g: Int): Bool = 
    always [0.0, 30.0] (
        (!(gear == g) && next (gear == g))
         => next (always [0.0, 2.5] (gear == g))
    )

/// The vehicle should remain steady at each of the gears 1 to 4
spec gearSteady = gearSteadyFor(1) && gearSteadyFor(2) && gearSteadyFor(3) && gearSteadyFor(4)

/// AT6a: (□_[0.0, 30.0] (RPM < 3000.0) ==> □_[0.0, 4.0] (speed < 35.0))
spec rpmSpeed4 = 
    (always [0.0, 30.0] (rpm < 3000.0) 
        => always [0.0, 4.0] (speed < 35.0)
    )

/// AT6b: (□_[0.0, 30.0] (RPM < 3000.0) ==> □_[0.0, 8.0] (speed < 50.0))
spec rpmSpeed8 = 
    (always [0.0, 30.0] (rpm < 3000.0) 
        => always [0.0, 8.0] (speed < 50.0)
    )

/// AT6c: (□_[0.0, 30.0] (RPM < 3000.0) ==> □_[0.0, 20.0] (speed < 65.0))
spec rpmSpeed20 = 
    (always [0.0, 30.0] (rpm < 3000.0) 
        => always [0.0, 20.0] (speed < 65.0)
    )

#[disable(redundancy)]
/// A Relation between RPM and Speed: The speed does not abruptly increase when RPM is below 3000
spec rpmSpeed = rpmSpeed4 && rpmSpeed8 && rpmSpeed20

/// When RPM is above or equal to 3000, within 30 seconds,
/// speed should be at least 35 for the first 4 seconds
spec rpmSpeedMin = always[0,30] ((rpm >= 3000) => (always[0,4] speed >= 35) )